# Copy to .env and fill — you provide these
GROK_API_KEY=paste-grok-key-here
GROK_MODEL=grok-2-latest
SUPABASE_URL=paste-supabase-url-here
SUPABASE_ANON_KEY=paste-supabase-anon-key-here
API_PORT=8765
# Global Osok-AI token — auto-generated into .env, paste it in desktop/mobile/extension Settings
OSOKAI_AUTH_TOKEN=paste-osokai-token-here

# ---- cloud (VPS) only: set these on the server, see docs/DEPLOY.md ----
# DOMAIN=osokai.example.com            # your DNS A-record -> VPS IP (Caddy gets TLS)
# OSOKAI_CORS=https://osokai.example.com
# OSOKAI_RELAY_KEY=auto-via-scripts   # run: python scripts/cloud-secrets.py
# OSOKAI_DATA_DIR=/data               # set by Dockerfile; override only for bare-metal
# OSOKAI_WS_DIR=/data/workspace
