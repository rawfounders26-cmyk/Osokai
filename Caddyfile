{$DOMAIN} {
	reverse_proxy osokai:8765

	header {
		# hardening without touching app code
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	encode gzip

	# NOTE (F08): stock caddy:2-alpine has no rate_limit module. Abuse shielding
	# lives in the backend limiter + lockout; keep this file valid on stock Caddy.
	# If edge rate-limiting is ever needed, pin a custom Caddy build with the
	# rate-limit module and re-add the block here.

	log {
		output stdout
		format json
	}
}
